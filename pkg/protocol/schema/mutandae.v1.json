{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutandae.dev/schema/mutandae.v1.json",
  "title": "μTandae Protocol v1",
  "description": "JSON Schema for μTandae Protocol v1 wire objects.",
  "anyOf": [
    {
      "$ref": "#/$defs/ListResponse"
    },
    {
      "$ref": "#/$defs/ConfigurationResponse"
    },
    {
      "$ref": "#/$defs/InspectResponse"
    },
    {
      "$ref": "#/$defs/RegisterRequest"
    },
    {
      "$ref": "#/$defs/RegisterResponse"
    },
    {
      "$ref": "#/$defs/RotateRequest"
    },
    {
      "$ref": "#/$defs/RotateResponse"
    },
    {
      "$ref": "#/$defs/RetireRequest"
    },
    {
      "$ref": "#/$defs/RetireResponse"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    },
    {
      "$ref": "#/$defs/DiscoveryIndex"
    },
    {
      "$ref": "#/$defs/AzureIntegrationRequest"
    },
    {
      "$ref": "#/$defs/AzureIntegrationRequirementsResponse"
    },
    {
      "$ref": "#/$defs/AzureIntegrationResponse"
    },
    {
      "$ref": "#/$defs/AzureApplicationsResponse"
    },
    {
      "$ref": "#/$defs/AzureApplicationResponse"
    },
    {
      "$ref": "#/$defs/AzureSecretResponse"
    },
    {
      "$ref": "#/$defs/AzureApplicationCreateRequest"
    },
    {
      "$ref": "#/$defs/AzureSecretCreateRequest"
    },
    {
      "$ref": "#/$defs/AzureSecretReadRequest"
    },
    {
      "$ref": "#/$defs/AzureSecretInvalidateRequest"
    },
    {
      "$ref": "#/$defs/AzureSecretReadResponse"
    },
    {
      "$ref": "#/$defs/AzureSecretInvalidateResponse"
    }
  ],
  "$defs": {
    "ProviderBinding": {
      "type": "object",
      "$comment": "Provider-neutral binding. The `provider` token names the adapter; shipped simulated kinds are `azure-entra`, `aws-iam`, and `gcp-iam` (see ../docs/protocol.md sections 2.2 for per-provider field conventions, without making any of them here). The provider-specific identifier fields (`tenant_id`, `object_id`, `region`, `account_id`, `project_id`) are opaque to the control plane, so this block intentionally stays loose and does not enumerate provider kind values.",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": "string"
        },
        "object_id": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "account_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "provider_id"
      ]
    },
    "ProviderDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "allow": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "deny": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "required": ["kind", "label", "scope"]
    },
    "Ownership": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "team": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "criticality": {
          "type": "string"
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "team",
        "service",
        "purpose"
      ]
    },
    "LifecyclePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "renewal_period": {
          "type": "string",
          "pattern": "^(?:P(?:(?:[0-9]+(?:\\.[0-9]+)?)(?:D|W))+(?:T(?:(?:[0-9]+(?:\\.[0-9]+)?)(?:H|M|S))*)?|PT(?:(?:[0-9]+(?:\\.[0-9]+)?)(?:H|M|S))+)$"
        },
        "grace_period": {
          "$ref": "#/$defs/ISO8601Duration"
        },
        "max_age": {
          "$ref": "#/$defs/ISO8601Duration"
        },
        "approval_required": {
          "type": "boolean"
        }
      },
      "required": [
        "renewal_period",
        "approval_required"
      ]
    },
    "CredentialReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "delivery": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "location"
      ]
    },
    "Metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "MachineIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderBinding"
        },
        "ownership": {
          "$ref": "#/$defs/Ownership"
        },
        "policy": {
          "$ref": "#/$defs/LifecyclePolicy"
        },
        "credential": {
          "$ref": "#/$defs/CredentialReference"
        },
        "state": {
          "$ref": "#/$defs/State"
        },
        "health": {
          "$ref": "#/$defs/Health"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_rotated_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        }
      },
      "required": [
        "id",
        "name",
        "provider",
        "ownership",
        "state",
        "health"
      ]
    },
    "LifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "identity_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/EventType"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/Metadata"
        }
      },
      "required": [
        "id",
        "identity_id",
        "type",
        "summary",
        "actor",
        "outcome",
        "at"
      ]
    },
    "PlannedOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "op": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "reversible": {"type": "boolean"},
        "destructive": {"type": "boolean"}
      },
      "required": ["op", "identity", "detail", "reversible", "destructive"]
    },
    "Plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {"const": true},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/PlannedOperation"}},
        "expires_hint": {"type": "string", "minLength": 1}
      },
      "required": ["dry_run", "operations", "expires_hint"]
    },
    "RotationRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "identity_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/RotationStatus"
        },
        "requested_by": {
          "type": "string"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "evidence": {
          "$ref": "#/$defs/CredentialReference"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "identity_id",
        "status"
      ]
    },
    "State": {
      "type": "string",
      "enum": [
        "registered",
        "active",
        "renewing",
        "retired"
      ]
    },
    "Health": {
      "type": "string",
      "enum": [
        "healthy",
        "attention"
      ]
    },
    "Urgency": {
      "type": "string",
      "enum": [
        "healthy",
        "expiring",
        "overdue",
        "retired"
      ]
    },
    "RotationStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "rolled_back"
      ]
    },
    "Outcome": {
      "type": "string",
      "enum": [
        "success",
        "in_progress",
        "attention",
        "failure",
        "cancelled"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "conformance_failure",
        "not_found",
        "invalid_transition",
        "already_retired",
        "rotation_in_progress",
        "provider_failure",
        "unsupported_version",
        "conflict",
        "internal",
        "unimplemented",
        "forbidden"
      ]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "identity.discovered",
        "identity.registered",
        "identity.imported",
        "ownership.assigned",
        "ownership.changed",
        "policy.applied",
        "renewal.alerted",
        "expiry.imminent",
        "expiry.overdue",
        "rotation.requested",
        "rotation.started",
        "rotation.completed",
        "rotation.failed",
        "rotation.rolled_back",
        "credential.delivered",
        "credential.used",
        "credential.revoked",
        "identity.retired",
        "identity.revoked",
        "identity.resurrected",
        "identity.deleted",
        "integration.connected",
        "application.created",
        "secret.created",
        "secret.read",
        "secret.invalidated",
        "integration.closed"
      ]
    },
    "ISO8601Duration": {
      "type": "string",
      "pattern": "^(?:P(?:(?:[0-9]+(?:\\.[0-9]+)?)(?:D|W))+(?:T(?:(?:[0-9]+(?:\\.[0-9]+)?)(?:H|M|S))*)?|PT(?:(?:[0-9]+(?:\\.[0-9]+)?)(?:H|M|S))+)$"
    },
    "VaultConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "secret_prefix": {"type": "string"},
        "owner_object_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}}
      },
      "required": ["url"]
    },
    "AzureIntegrationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1},
        "client_id": {"type": "string", "format": "uuid"},
        "client_secret": {"type": "string", "minLength": 1},
        "vault": {"$ref": "#/$defs/VaultConfiguration"},
        "requested_by": {"type": "string"}
      },
      "required": ["tenant_id", "client_id", "client_secret"]
    },
    "AzureIntegrationRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "graph_application_permission": {"type": "string"},
        "graph_operations": {"type": "array", "items": {"type": "string"}},
        "vault_optional": {"type": "boolean"},
        "vault_write_role": {"type": "string"},
        "vault_read_role": {"type": "string"},
        "owner_enforcement": {"type": "string"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["graph_application_permission", "graph_operations", "vault_optional", "owner_enforcement", "warnings"]
    },
    "AzureIntegrationSession": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "provider": {"type": "string"},
        "tenant_hint": {"type": "string"},
        "client_hint": {"type": "string"},
        "expires_at": {"type": "string", "format": "date-time"},
        "vault_configured": {"type": "boolean"},
        "capabilities": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["id", "provider", "tenant_hint", "client_hint", "expires_at", "vault_configured", "capabilities"]
    },
    "AzureIntegrationEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "correlation_id": {"type": "string"},
        "at": {"type": "string", "format": "date-time"},
        "outcome": {"$ref": "#/$defs/Outcome"},
        "provider": {"type": "string"},
        "application_id": {"type": "string"},
        "details": {"$ref": "#/$defs/Metadata"}
      },
      "required": ["id", "type", "correlation_id", "at", "outcome", "provider"]
    },
    "OperationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "correlation_id": {"type": "string"},
        "event_published": {"type": "boolean"},
        "event": {"$ref": "#/$defs/AzureIntegrationEvent"}
      },
      "required": ["id", "correlation_id", "event_published", "event"]
    },
    "AzureCredential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key_id": {"type": "string"},
        "display_name": {"type": "string"},
        "start_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "hint": {"type": "string"},
        "vault": {"$ref": "#/$defs/VaultReference"}
      },
      "required": ["key_id"]
    },
    "VaultReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "secret_name": {"type": "string"},
        "version": {"type": "string"},
        "expires_at": {"type": "string", "format": "date-time"},
        "owner_object_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}}
      },
      "required": ["url", "secret_name"]
    },
    "AzureApplication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": {"type": "string", "format": "uuid"},
        "application_id": {"type": "string", "format": "uuid"},
        "display_name": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "owned_by_calling_client": {"type": "boolean"},
        "credentials": {"type": "array", "items": {"$ref": "#/$defs/AzureCredential"}}
      },
      "required": ["object_id", "application_id", "display_name", "owned_by_calling_client"]
    },
    "AzureSecretResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credential": {"$ref": "#/$defs/AzureCredential"},
        "secret_text": {"type": "string"},
        "one_time": {"type": "boolean"},
        "vault": {"$ref": "#/$defs/VaultReference"}
      },
      "required": ["credential", "one_time"]
    },
    "AzureIntegrationRequirementsResponse": {
      "type": "object", "additionalProperties": false,
      "properties": {"api_version": {"const": "v1"}, "requirements": {"$ref": "#/$defs/AzureIntegrationRequirements"}},
      "required": ["api_version", "requirements"]
    },
    "AzureIntegrationResponse": {
      "type": "object", "additionalProperties": false,
      "properties": {"api_version": {"const": "v1"}, "session": {"$ref": "#/$defs/AzureIntegrationSession"}, "csrf_token": {"type": "string"}},
      "required": ["api_version", "session"]
    },
    "AzureApplicationsResponse": {
      "type": "object", "additionalProperties": false,
      "properties": {"api_version": {"const": "v1"}, "applications": {"type": "array", "items": {"$ref": "#/$defs/AzureApplication"}}, "receipt": {"$ref": "#/$defs/OperationReceipt"}, "error": {"$ref": "#/$defs/Error"}},
      "required": ["api_version", "applications"]
    },
    "AzureApplicationResponse": {
      "type": "object", "additionalProperties": false,
      "properties": {"api_version": {"const": "v1"}, "application": {"$ref": "#/$defs/AzureApplication"}, "receipt": {"$ref": "#/$defs/OperationReceipt"}, "error": {"$ref": "#/$defs/Error"}},
      "required": ["api_version", "application"]
    },
    "AzureApplicationCreateRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {"display_name": {"type": "string", "minLength": 1}},
      "required": ["display_name"]
    },
    "AzureSecretCreateRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {"application_object_id": {"type": "string", "format": "uuid"}, "display_name": {"type": "string", "minLength": 1}, "expires_at": {"type": "string", "format": "date-time"}, "store_in_vault": {"type": "boolean"}},
      "required": ["application_object_id", "display_name", "store_in_vault"]
    },
    "AzureSecretReadRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {"application_object_id": {"type": "string", "format": "uuid"}, "key_id": {"type": "string", "format": "uuid"}, "version": {"type": "string"}},
      "required": ["application_object_id", "key_id"]
    },
    "AzureSecretInvalidateRequest": {
      "$ref": "#/$defs/AzureSecretReadRequest"
    },
    "AzureSecretResponse": {
      "type": "object", "additionalProperties": false,
      "properties": {"api_version": {"const": "v1"}, "secret": {"$ref": "#/$defs/AzureSecretResult"}, "receipt": {"$ref": "#/$defs/OperationReceipt"}, "error": {"$ref": "#/$defs/Error"}},
      "required": ["api_version", "secret", "receipt"]
    },
    "AzureSecretReadResponse": {
      "$ref": "#/$defs/AzureSecretResponse"
    },
    "AzureSecretInvalidateResponse": {
      "type": "object", "additionalProperties": false,
      "properties": {"api_version": {"const": "v1"}, "credential": {"$ref": "#/$defs/AzureCredential"}, "receipt": {"$ref": "#/$defs/OperationReceipt"}, "error": {"$ref": "#/$defs/Error"}},
      "required": ["api_version", "credential", "receipt"]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/Metadata"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "Configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {"type": "string"},
        "protocol_version": {"type": "string"},
        "media_type": {"type": "string"},
        "environment": {"type": "string"},
        "provider": {"type": "string"},
        "persistence": {"type": "string"},
        "read_only": {"type": "boolean"},
        "features": {"type": "array", "items": {"type": "string"}},
        "providers": {"type": "array", "items": {"$ref": "#/$defs/ProviderDescriptor"}},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "required": ["service", "protocol_version", "media_type", "environment", "provider", "persistence", "read_only", "features", "updated_at"]
    },
    "ConfigurationResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {"const": "v1"},
        "configuration": {"$ref": "#/$defs/Configuration"},
        "error": {"$ref": "#/$defs/Error"}
      },
      "required": ["api_version", "configuration"]
    },
    "ListRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/State"
        },
        "limit": {
          "type": "integer"
        },
        "after": {
          "type": "string"
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "InspectRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "DiscoveryResource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rel": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "envelope": {
          "type": "string"
        }
      },
      "required": [
        "rel",
        "method",
        "href"
      ]
    },
    "ListResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "v1"
        },
        "total": {
          "type": "integer"
        },
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MachineIdentity"
          }
        },
        "omitted": {
          "type": "integer"
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "api_version",
        "total",
        "identities"
      ]
    },
    "InspectResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "v1"
        },
        "identity": {
          "$ref": "#/$defs/MachineIdentity"
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "api_version",
        "identity"
      ]
    },
    "RegisterRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
