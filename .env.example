# Runtime configuration for the runnable demo. These are non-secret:
# provider adapters, control planes, and the frontend all speak the
# versioned μTandae Protocol (see docs/protocol.md).

# Port the demo HTTP server listens on.
PORT=8080

# Safe UI/environment label and Redis key-prefix segment. Use preview or live.
MUTANDAE_ENVIRONMENT=preview

# Simulated Azure/Entra ID tenant label the demo adapter presents. This is not
# a real tenant connection and is never exposed by the configuration page.
MUTANDAE_TENANT=8c0e6c1a-mutandae-4c3b-9f2d-000000000000-demo

# Simulated AWS IAM account id and region the demo AWS adapter presents.
MUTANDAE_AWS_ACCOUNT=123456789012
MUTANDAE_AWS_REGION=us-east-1

# Simulated Google Cloud project id and region the demo GCP adapter presents.
MUTANDAE_GCP_PROJECT=mutandae-demo
MUTANDAE_GCP_REGION=us-central1

# Provider identity scope allow-lists. Values are comma-separated path.Match
# (fnmatch-style, not regular-expression) patterns; prefix a pattern with ! to
# deny it. Unset preview/local scopes use mutandae-demo-* for simulators and
# the same explicit safe scope when real adapters are wired.
MUTANDAE_AZURE_SCOPE=mutandae-demo-*
MUTANDAE_AWS_SCOPE=mutandae-demo-*
MUTANDAE_GCP_SCOPE=mutandae-demo-*

# Optional temporary persistence/pub-sub backend. Leave unset for in-memory
# local development. If set, startup fails closed when Redis is unavailable.
REDIS_URL=redis://localhost:6379/0

# Durable lifecycle audit JSONL sink. Leave empty to disable. The parent
# directory is created with owner-only permissions and the file is append-only.
MUTANDAE_AUDIT_FILE=

# Scheduled lifecycle renewal is intentionally DISABLED by default. Set an
# explicit positive Go duration (for example 1h) only when automatic rotation
# is approved for this environment. MUTANDAE_SWEEP_JITTER defaults to interval/10.
MUTANDAE_SWEEP_INTERVAL=
MUTANDAE_SWEEP_JITTER=

# Vault delivery (on by default; set to "off" to disable entirely). Provisioned
# and renewed demo credentials are written to the provider's native vault:
# AWS Secrets Manager for aws-iam, GCP Secret Manager for gcp-iam, and Azure
# Key Vault for azure-entra. The governor principals need the least-privilege
# vault permissions documented in docs/live-demo.md.
MUTANDAE_VAULT=auto

# Azure Key Vault endpoint used for azure-entra credential delivery. Must be an
# existing HTTPS *.vault.azure.net vault the governor app can write to.
AZURE_KEY_VAULT_URL=
# Optional Key Vault secret-name prefix (default "mutandae").
AZURE_KEY_VAULT_PREFIX=mutandae

# Cluster-local μVault (HashiCorp Vault KV v2) — the common vault where demo
# credentials persist in the cluster. Set both to enable mirroring; the token
# must be scoped to the demo policy (see docs/live-demo.md runbook).
VAULT_ADDR=
VAULT_TOKEN=
# KV v2 mount name and path prefix inside the cluster vault. The hosted
# deployments use mount "mutandae" and per-environment prefixes demo/live and
# demo/preview.
VAULT_MOUNT=mutandae
VAULT_SECRET_PREFIX=demo

# Authentication (default: public demo). In live environments, choose oidc or
# token; auth=none is rejected at startup. OIDC uses the hand-written stdlib
# authorization-code flow with state, nonce, and S256 PKCE.
MUTANDAE_AUTH_MODE=none
MUTANDAE_OIDC_ISSUER_URL=
MUTANDAE_OIDC_CLIENT_ID=
MUTANDAE_OIDC_CLIENT_SECRET=
# Optional; otherwise scheme://request-host/auth/callback is used.
MUTANDAE_OIDC_REDIRECT_URL=
MUTANDAE_OIDC_SCOPES=openid profile email

# Quickstart API token (raw value is hashed in memory and never logged).
MUTANDAE_API_TOKEN=
# Or point to a JSON array containing only SHA-256 hex digests and roles:
# [{"name":"ci","token_sha256":"<64 hex chars>","role":"operator"}]
MUTANDAE_API_TOKENS_FILE=
# Generate a token and its file digest without putting the raw token in the file:
# TOKEN="$(openssl rand -hex 32)"; printf '%s\n' "$TOKEN"; printf '%s' "$TOKEN" | sha256sum
# The session signing key is generated at startup when unset. Set a shared
# random hex key for multi-instance OIDC deployments:
MUTANDAE_SESSION_KEY=

# Observability is always on; /metrics is a public Prometheus 0.0.4 endpoint.
# Request logs are JSON lines and include X-Request-Id correlation values.
