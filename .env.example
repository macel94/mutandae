# Runtime configuration for the runnable demo. These are non-secret:
# provider adapters, control planes, and the frontend all speak the
# versioned μTandae Protocol (see docs/protocol.md).

# Port the demo HTTP server listens on.
PORT=8080

# Safe UI/environment label and Redis key-prefix segment. Use preview or live.
MUTANDAE_ENVIRONMENT=preview

# Simulated Azure/Entra ID tenant label the demo adapter presents. This is not
# a real tenant connection and is never exposed by the configuration page.
MUTANDAE_TENANT=8c0e6c1a-mutandae-4c3b-9f2d-000000000000-demo

# Simulated AWS IAM account id and region the demo AWS adapter presents.
MUTANDAE_AWS_ACCOUNT=123456789012
MUTANDAE_AWS_REGION=us-east-1

# Simulated Google Cloud project id and region the demo GCP adapter presents.
MUTANDAE_GCP_PROJECT=mutandae-demo
MUTANDAE_GCP_REGION=us-central1

# Optional temporary persistence/pub-sub backend. Leave unset for in-memory
# local development. If set, startup fails closed when Redis is unavailable.
REDIS_URL=redis://localhost:6379/0

# Vault delivery (on by default; set to "off" to disable entirely). Provisioned
# and renewed demo credentials are written to the provider's native vault:
# AWS Secrets Manager for aws-iam, GCP Secret Manager for gcp-iam, and Azure
# Key Vault for azure-entra. The governor principals need the least-privilege
# vault permissions documented in docs/live-demo.md.
MUTANDAE_VAULT=auto

# Azure Key Vault endpoint used for azure-entra credential delivery. Must be an
# existing HTTPS *.vault.azure.net vault the governor app can write to.
AZURE_KEY_VAULT_URL=
# Optional Key Vault secret-name prefix (default "mutandae").
AZURE_KEY_VAULT_PREFIX=mutandae

# Cluster-local μVault (HashiCorp Vault KV v2) — the common vault where demo
# credentials persist in the cluster. Set both to enable mirroring; the token
# must be scoped to the demo policy (see docs/live-demo.md runbook).
VAULT_ADDR=
VAULT_TOKEN=
# KV v2 mount name and path prefix inside the cluster vault. The hosted
# deployments use mount "mutandae" and per-environment prefixes demo/live and
# demo/preview.
VAULT_MOUNT=mutandae
VAULT_SECRET_PREFIX=demo
